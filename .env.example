# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API Keys

# Project URL – safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_…) or legacy "anon" key – safe to expose,
# Row Level Security protects the data. (NEXT_PUBLIC_SUPABASE_ANON_KEY also works.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Secret key (sb_secret_…) or legacy "service_role" key – SERVER ONLY.
# Never commit it and never prefix it with NEXT_PUBLIC_.
# Used to create/delete login accounts and by `npm run seed`.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
